                                                <Setter Property="Background" Value="{StaticResource SystemManager_LinearColorResources_02}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EquipmentInfo[167].Result}" Value="Incubation">
                                                        <Setter Property="Background" Value="{StaticResource SystemManager_LinearColorResources_03}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EquipmentInfo[167].Result}" Value="Positive">
                                                        <Setter Property="Background" Value="{StaticResource SystemManager_LinearColorResources_05}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EquipmentInfo[167].Result}" Value="Negative">
                                                        <Setter Property="Background" Value="{StaticResource SystemManager_LinearColorResources_04}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EquipmentInfo[167].Result}" Value="Block">
                                                        <Setter Property="Background" Value="{StaticResource SystemManager_LinearColorResources_07}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Equipment_DataWithDB_presenceArray[167].alive}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="Equipment_DataWithDB_presenceArray">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0.2"
                                                         Duration="0:0:0.500" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Equipment_DataWithDB_presenceArray" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding System_PositiveFirstint}" Value="167">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="PositiveFirst">
                                                                <Storyboard>
                                                                    <DoubleAnimation
AutoReverse="True"
RepeatBehavior="Forever"
Storyboard.TargetProperty="Opacity"
From="1"
To="0.2"
Duration="0:0:0.500" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="PositiveFirst" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding System_IncubationFirstint}" Value="167">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="IncubationFirstint">
                                                                <Storyboard>
                                                                    <DoubleAnimation
AutoReverse="True"
RepeatBehavior="Forever"
Storyboard.TargetProperty="Opacity"
From="1"
To="0.2"
Duration="0:0:0.500" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="IncubationFirstint" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100*" />
                                            <RowDefinition Height="100*" />
                                            <RowDefinition Height="2*" />
                                            <RowDefinition Height="100*" />
                                            <RowDefinition Height="100*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Login}" Value="USER">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Style="{StaticResource SystemManager_TextBlock_01}" Text="{Binding PCB_Data[167].ADC, StringFormat='V : {0:F0}'}" />
                                        </Grid>
                                        <Grid Grid.Row="3">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Login}" Value="USER">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Style="{StaticResource SystemManager_TextBlock_02}" Text="{Binding PCB_Data[167].LED, StringFormat='L : {0:F0}'}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <TextBlock
     VerticalAlignment="Top"
     Style="{StaticResource SystemManager_TextBlock_04}"
     Text="84" />
                                </Grid>
                            </Grid>
                            <!--#endregion 83-->

                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
